!#############################################################
!## Diphoton EVENT-LEVEL Chebyshev moments (ATLAS 8 TeV 1704.03839 fiducial).
!##   Born   : <T_n(m_aa)>   n=1..6   (log map [80,700])
!##   recoil : <T_n(pt_aa)>_w n=1..12 (log map [1,500], SMOOTH profile [28,56]->500)
!## Denominators (normal single-bin; bin widths cancel in the ratio):
!##   norm_born  = sigma_fid            (normal single-bin of chebT_maa_1)
!##   prof_wpt_0 = sum_j w_j w(pt_j)    (profile of w_ptaa) -> w-rate R
!## <T_n>_Born = prof_maa_n/norm_born ;  <T_n>_w = prof_wpt_n/prof_wpt_0
!## Reference distributions kept for the plots + cross-checks.
!#############################################################

PROCESS  GG
  collider = LHC
  sqrts = 8000.0
  photon_isolation = frix[R_cone=0.4, ETmax_const=11d0, n=1]
  decay_type = 0
END_PROCESS

RUN  GG_WINVAR
  PDF = CT18NNLO[0]
  tcut = 1d-9
  iseed = 1
  reset_vegas_grid = .true.
  angular_average  = .false.
  multi_channel    = .false.
  lips_reduce      = .true.
  production = 100000[10]
END_RUN

PARAMETERS
  SCHEME[GV]  = CMS
  SCHEME[alpha] = Gmu
  hard_photon_alpha0 = .true.
END_PARAMETERS

SELECTORS
  select dr_g1g2 min = 0.4
  select ptg1 min = 40
  select ptg2 min = 30
  select photons_abs_y max = 2.37
  reject photons_abs_y min = 1.37 max = 1.56
END_SELECTORS

HISTOGRAMS
  ! ---- SLIM production card (nnlojet-winvar): reference distributions, Born moments and
  ! ---- jet followers of the source card dropped (not needed for the windowed recoil moments)
  chebT_maa_1 > norm_born   min=-1.001 max=1.001 nbins=1
  w_ptaa      > prof_wpt_0  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_1  > prof_wpt_1   min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_2  > prof_wpt_2   min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_3  > prof_wpt_3   min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_4  > prof_wpt_4   min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_5  > prof_wpt_5   min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_6  > prof_wpt_6   min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_7  > prof_wpt_7   min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_8  > prof_wpt_8   min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_9  > prof_wpt_9   min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_10 > prof_wpt_10  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_11 > prof_wpt_11  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_12 > prof_wpt_12  min=-1.001 max=1.001 nbins=1 profile = T
  ! ---- MATCHING-WINDOW VARIANTS (nnlojet-winvar), same log map and closing edge
  ! ---- as the nominal w_ptaa (pa,pb) = (28, 56):  A = (19, 38), B = (37, 74), C = (28, 112)
  ! ---- <T_n>_V = prof_wptV_n / prof_wptV_0 ;  R_V = prof_wptV_0 / sigma_fid
  w_ptaa_A > prof_wptA_0  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_1 > prof_wptA_1  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_2 > prof_wptA_2  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_3 > prof_wptA_3  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_4 > prof_wptA_4  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_5 > prof_wptA_5  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_6 > prof_wptA_6  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_7 > prof_wptA_7  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_8 > prof_wptA_8  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_9 > prof_wptA_9  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_10 > prof_wptA_10  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_11 > prof_wptA_11  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_A_12 > prof_wptA_12  min=-1.001 max=1.001 nbins=1 profile = T
  w_ptaa_B > prof_wptB_0  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_1 > prof_wptB_1  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_2 > prof_wptB_2  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_3 > prof_wptB_3  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_4 > prof_wptB_4  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_5 > prof_wptB_5  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_6 > prof_wptB_6  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_7 > prof_wptB_7  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_8 > prof_wptB_8  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_9 > prof_wptB_9  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_10 > prof_wptB_10  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_11 > prof_wptB_11  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_B_12 > prof_wptB_12  min=-1.001 max=1.001 nbins=1 profile = T
  w_ptaa_C > prof_wptC_0  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_1 > prof_wptC_1  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_2 > prof_wptC_2  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_3 > prof_wptC_3  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_4 > prof_wptC_4  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_5 > prof_wptC_5  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_6 > prof_wptC_6  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_7 > prof_wptC_7  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_8 > prof_wptC_8  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_9 > prof_wptC_9  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_10 > prof_wptC_10  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_11 > prof_wptC_11  min=-1.001 max=1.001 nbins=1 profile = T
  chebTw_ptaa_C_12 > prof_wptC_12  min=-1.001 max=1.001 nbins=1 profile = T
END_HISTOGRAMS

SCALES
  muf = 1.0 * Mg1g2  mur = 1.0 * Mg1g2
  muf = 2.0 * Mg1g2  mur = 2.0 * Mg1g2
  muf = 0.5 * Mg1g2  mur = 0.5 * Mg1g2
  muf = 1.0 * Mg1g2  mur = 2.0 * Mg1g2
  muf = 2.0 * Mg1g2  mur = 1.0 * Mg1g2
  muf = 0.5 * Mg1g2  mur = 1.0 * Mg1g2
  muf = 1.0 * Mg1g2  mur = 0.5 * Mg1g2
END_SCALES

CHANNELS
  R
END_CHANNELS
