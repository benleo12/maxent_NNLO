+  ! gg -> H color-corrected transition region (v_m = 54 GeV): D = (54,108), the default window,
+  ! E = (72,144) and F = (54,216), its variants; copies of the nominal w_pth/chebTw_pth with other (pa, pb)
+  real(kind=wp) function eval_w_pth_D(npar)          ! (54,108)
+    integer, intent(in) :: npar
+    real(kind=wp), dimension(4) :: pV
+    if (npar < 1) then; eval_w_pth_D = 0.0_wp; return; end if
+    pV(1:4) = kin(npar)%p(1:4, npar - 1) + kin(npar)%p(1:4, npar)
+    eval_w_pth_D = prof_w(v1_pt(pV), 54.0_wp, 108.0_wp, 1000.0_wp, 1000.0_wp)
+  end function eval_w_pth_D
