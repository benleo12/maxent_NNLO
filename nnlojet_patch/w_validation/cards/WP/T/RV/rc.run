  wval_pt_8 > prof_wptw_8 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_9 > prof_wptw_9 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_10 > prof_wptw_10 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_11 > prof_wptw_11 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_12 > prof_wptw_12 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_13 > prof_wptw_13 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_14 > prof_wptw_14 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_15 > prof_wptw_15 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_16 > prof_wptw_16 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_17 > prof_wptw_17 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_18 > prof_wptw_18 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_19 > prof_wptw_19 min=-1.001 max=1.001 nbins=1 profile=T
  wval_pt_20 > prof_wptw_20 min=-1.001 max=1.001 nbins=1 profile=T
  chebTw_ctw_1 > prof_wctw_1 min=-1.001 max=1.001 nbins=1 profile=T
  chebTw_ctw_2 > prof_wctw_2 min=-1.001 max=1.001 nbins=1 profile=T
  chebTw_ctw_3 > prof_wctw_3 min=-1.001 max=1.001 nbins=1 profile=T
  chebTw_ctw_4 > prof_wctw_4 min=-1.001 max=1.001 nbins=1 profile=T
  chebTw_ctw_5 > prof_wctw_5 min=-1.001 max=1.001 nbins=1 profile=T
  chebTw_ctw_6 > prof_wctw_6 min=-1.001 max=1.001 nbins=1 profile=T
  w_ptw > prof_wptw_0 min=-1.001 max=1.001 nbins=1 profile=T
  w_ctw > prof_wctw_0 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_10 > prof_yc_10 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_11 > prof_yc_11 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_12 > prof_yc_12 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_13 > prof_yc_13 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_14 > prof_yc_14 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_20 > prof_yc_20 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_21 > prof_yc_21 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_22 > prof_yc_22 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_23 > prof_yc_23 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_24 > prof_yc_24 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_30 > prof_yc_30 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_31 > prof_yc_31 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_32 > prof_yc_32 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_33 > prof_yc_33 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_34 > prof_yc_34 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_40 > prof_yc_40 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_41 > prof_yc_41 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_42 > prof_yc_42 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_43 > prof_yc_43 min=-1.001 max=1.001 nbins=1 profile=T
  wval_yc_44 > prof_yc_44 min=-1.001 max=1.001 nbins=1 profile=T
END_HISTOGRAMS

SCALES
  mur = 1.0 * mln  muf = 1.0 * mln
  mur = 2.0 * mln  muf = 2.0 * mln
  mur = 0.5 * mln  muf = 0.5 * mln
  mur = 2.0 * mln  muf = 1.0 * mln
  mur = 1.0 * mln  muf = 2.0 * mln
  mur = 0.5 * mln  muf = 1.0 * mln
  mur = 1.0 * mln  muf = 0.5 * mln
END_SCALES

CHANNELS
  RV
END_CHANNELS
