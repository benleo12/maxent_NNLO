!#############################################################
!## WP production, 7 TeV, ATLAS 1109.5141 fiducial (pT_l>20, |eta_l|<2.5, ET_miss>25, m_T>40) (W -> l nu).
!## Event-level Chebyshev moments for maxent_upgrade, same construction as
!## the Drell-Yan production (dy_moments_log30_hi.run) with the W in place
!## of the Z:
!##   Born   : <T_n(m_W)>   n=1..12  (Breit-Wigner map [40,1000] around M_W, Gamma_W)
!##            <T_n(|y_W|)> n=1..12  (linear map [0,4])
!##            <T_n(cos th*)> n=1..8 (signed CS decay angle of the charged lepton, linear map [-1,1])
!##   recoil : <T_n(pT_W)>_w n=1..20 (log map [25,2500], smooth profile [25,50] -> 500)
!## Denominators: norm_born = sigma_fid (single bin of chebT_mw_1),
!##               prof_wptw_0 = sum_j w_j w(pT_W,j)  ->  w-rate R = prof_wptw_0/sigma_fid
!## Reference histograms for the follower comparisons: lepton |eta| on the
!## ATLAS binning, lepton pT, m_T, ET_miss, pT_W, |y_W|, m_W.
!#############################################################

PROCESS  WP
  collider = pp
  sqrts = 7000.0
  jet = none[0]
END_PROCESS

RUN W_VALID_V
  PDF = CT18NNLO[0]
  tcut = 1e-07
  iseed = 1

  production = 50000[5]
END_RUN

PARAMETERS
  MASS[Z]  = 91.1876
  WIDTH[Z] = 2.4952
  MASS[W]  = 80.385
  WIDTH[W] = 2.085
  CKM = FULL
  SCHEME[alpha] = Gmu
  SCHEME[WIDTH_V] = CMS
  GF = 1.1663787d-5
END_PARAMETERS

SELECTORS
  select ptlp  min = 20
  select abs_ylp  max = 2.5
  select etmiss  min = 25
  select mt  min = 40
END_SELECTORS

HISTOGRAMS
  chebT_mw_1 > norm_born min=-1.001 max=1.001 nbins=1
  abs_ylp > eta20 [0.0,0.21,0.42,0.63,0.84,1.05,1.37,1.52,1.74,1.95,2.18,2.5]
  wval_eta27 > eta27 [0.0,0.21,0.42,0.63,0.84,1.05,1.37,1.52,1.74,1.95,2.18,2.5]
  wval_eta30 > eta30 [0.0,0.21,0.42,0.63,0.84,1.05,1.37,1.52,1.74,1.95,2.18,2.5]
  ptlp > ptl [20,25,27,30,35,40,45,50,60,80,120,200]
  mt > mt [40,50,60,70,80,90,100,120,160,200]
  ptw > recoil [0,10,20,25,30,40,50,60,80,100,150,200,300,500]
END_HISTOGRAMS

SCALES
  mur = 1.0 * mln  muf = 1.0 * mln
  mur = 2.0 * mln  muf = 2.0 * mln
  mur = 0.5 * mln  muf = 0.5 * mln
  mur = 2.0 * mln  muf = 1.0 * mln
  mur = 1.0 * mln  muf = 2.0 * mln
  mur = 0.5 * mln  muf = 1.0 * mln
  mur = 1.0 * mln  muf = 0.5 * mln
END_SCALES

CHANNELS
  RR
END_CHANNELS
